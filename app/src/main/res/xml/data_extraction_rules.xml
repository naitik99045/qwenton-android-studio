<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted API keys and sensitive credentials from automatic cloud backup -->
        <exclude domain="sharedpref" path="qwenton_secure_prefs.xml" />
        <exclude domain="sharedpref" path="qwenton_secure_prefs_fallback.xml" />
        <!-- Exclude heavy binary models and custom agents from cloud quotas -->
        <exclude domain="file" path="models" />
        <exclude domain="file" path="agents" />
        <exclude domain="file" path="rootfs" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="qwenton_secure_prefs.xml" />
        <exclude domain="sharedpref" path="qwenton_secure_prefs_fallback.xml" />
    </device-transfer>
</data-extraction-rules>
